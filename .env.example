DATABASE_URL="postgresql://lkp:lkp_local_password@localhost:5432/lkp?schema=public"
APP_URL="http://localhost:3000"
# On Vercel, set APP_URL to the exact public production URL, for example:
# APP_URL="https://fgm-portal.vercel.app"
# Vercel preview/branch/production system URLs are also recognized automatically.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="lkpminio"
S3_SECRET_KEY="lkp_local_storage_password"
S3_BUCKET="lkp-private"
# Set false only for a provider that requires virtual-host addressing.
S3_FORCE_PATH_STYLE="true"
# Optional absolute persistent folder for uploaded videos.
# Default: <OS user home>/.lkp-academy/videos (outside the application).
# VIDEO_STORAGE_DIR="D:/LKP-Storage/videos"
# Seed exits in production unless ALLOW_DEMO_SEED=true is explicitly set.
DEMO_ADMIN_PASSWORD="AdminDemo!2026"
DEMO_STUDENT_PASSWORD="StudentDemo!2026"
